    {
      "parameters": {
        "jsCode": "// Input: array of items with `html`\n// Output: same items + `htmlClean` and `textClean`\n\nfunction stripQuoted(html = '') {\n  if (!html) return '';\n\n  // 1) Drop everything starting at Gmail's quote container\n  html = html.replace(/<div[^>]*class=\"[^\"]*\\bgmail_quote\\b[^\"]*\"[\\s\\S]*$/i, '');\n\n  // 2) Remove any remaining blockquotes\n  html = html.replace(/<blockquote[\\s\\S]*?<\\/blockquote>/gi, '');\n\n  // 3) Also drop the gmail_attr \"On ... wrote:\" line if it slipped through\n  html = html.replace(/<div[^>]*class=\"gmail_attr\"[^>]*>[\\s\\S]*$/i, '');\n\n  return html;\n}\n\nfunction htmlToText(html = '') {\n  return html\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/(div|p|li|h[1-6])>/gi, '\\n')\n    .replace(/<li>/gi, '• ')\n    .replace(/<[^>]+>/g, '')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .trim();\n}\n\nreturn $input.all().map(i => {\n  const m = i.json;\n\n  const html = m.html || m.textAsHtml || '';\n  const htmlClean = stripQuoted(html);\n  const textClean = htmlToText(htmlClean);\n\n  return {\n    json: {\n      ...m,\n      htmlClean,\n      textClean,   // e.g., \"Hi mishuk just wanted a follow up...\"\n    }\n  };\n});\n"
      },
